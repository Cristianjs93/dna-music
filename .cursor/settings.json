{
    "name": "DNA Music",
    "version": "1.0.0",
    "projectType": "monorepo",
    "primaryLanguages": ["typescript", "javascript"],
    "backend": {
      "framework": "nestjs",
      "orm": "prisma",
      "database": "postgresql"
    },
    "frontend": {
      "framework": "react"
    },
    "preferredPackageManger": "npm",
    "nodeVersion": "24.16.0",
    "rulesDirectory": ".cursor/rules",
    "enforceStrictTyping": true,
    "permissions": {
        "deny": [
          "Read(**/.env)",
          "Write(**/.env)"
        ]
      },
    "include": ["api/**", "web/**", ".github/workflows/**", "CLAUDE.md", "README.md", ".nvmrc", ".cursor/**"],
    "exclude": ["**/node_modules/**", "**/dist/**", "**/coverage/**", ".git/**"]
}