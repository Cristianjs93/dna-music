// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERADOR
}

enum StudentStatus {
  ACTIVO
  INACTIVO
  RETIRADO
}

model User {
  id            String       @id @default(uuid())
  name          String       @db.VarChar(150)
  email         String       @unique @db.VarChar(320)
  password      String       @db.VarChar(100)
  role          Role         @default(OPERADOR)
  headquarterId String?      @map("headquarter_id")
  headquarter   Headquarter? @relation(fields: [headquarterId], references: [id])
  createdById   String?      @map("created_by_id")
  updatedById   String?      @map("updated_by_id")
  createdBy     User?        @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?        @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  usersCreated  User[]       @relation("UserCreatedBy")
  usersUpdated  User[]       @relation("UserUpdatedBy")
  headquartersCreated Headquarter[] @relation("HeadquarterCreatedBy")
  headquartersUpdated Headquarter[] @relation("HeadquarterUpdatedBy")
  studentsCreated     Student[]     @relation("StudentCreatedBy")
  studentsUpdated     Student[]     @relation("StudentUpdatedBy")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)

  @@index([role])
  @@index([headquarterId])
  @@index([createdById])
  @@index([updatedById])
  @@map("users")
}

model Headquarter {
  id          String    @id @default(uuid())
  name        String    @unique @db.VarChar(150)
  city        String    @db.VarChar(100)
  address     String    @db.VarChar(255)
  isActive    Boolean   @default(true) @map("is_active")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  createdBy   User?     @relation("HeadquarterCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?     @relation("HeadquarterUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  students    Student[]
  users       User[]
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([isActive])
  @@index([createdById])
  @@index([updatedById])
  @@map("headquarters")
}

model Student {
  id             String        @id @default(uuid())
  fullName       String        @map("full_name") @db.VarChar(255)
  email          String        @unique @db.VarChar(320)
  phone          String        @unique @db.VarChar(20)
  identityCard   String        @unique @map("identity_card") @db.VarChar(20)
  program        String        @db.VarChar(100)
  status         StudentStatus @default(ACTIVO)
  enrollmentDate DateTime      @default(now()) @map("enrollment_date") @db.Timestamptz(6)
  headquarterId  String        @map("headquarter_id")
  headquarter    Headquarter   @relation(fields: [headquarterId], references: [id])
  createdById    String?       @map("created_by_id")
  updatedById    String?       @map("updated_by_id")
  createdBy      User?         @relation("StudentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?         @relation("StudentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)

  @@index([headquarterId])
  @@index([status])
  @@index([deletedAt])
  @@index([headquarterId, status])
  @@index([createdById])
  @@index([updatedById])
  @@map("students")
}
